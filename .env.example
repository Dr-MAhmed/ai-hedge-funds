# DeepSeek LLM Configuration
# Option 1: DeepSeek Official API (free 5M tokens on signup)
# Sign up at https://platform.deepseek.com/ for free API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Option 2: Puter.js Free DeepSeek (unlimited, no API key needed)
# Requires Node.js and @heyputer/puter.js installed
# Set to "true" to use Puter bridge instead of DeepSeek API
USE_PUTER=false
PUTER_AUTH_TOKEN=

# MetaTrader 5 Connection
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Trial7
MT5_PATH=

# Risk Management
DEFAULT_RISK_PERCENT=1.0
CONFIDENCE_THRESHOLD=65

# Engine Settings
SCAN_INTERVAL_SECONDS=30

# Symbols to trade (comma-separated)
SYMBOLS=EURUSDm,GBPUSDm,USDJPYm,USDCHFm,USDCADm,AUDUSDm,NZDUSDm,BTCUSDm,XAUUSDm

# Self-Learning Auditor
AUDIT_TRADE_THRESHOLD=10
AUDIT_COOLDOWN_HOURS=12





# Puter.js (disabled - not working)
# USE_PUTER=false
# PUTER_AUTH_TOKEN=